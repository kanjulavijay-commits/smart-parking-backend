# Copy this to .env and fill in your values
SECRET_KEY=django-insecure-replace-with-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave blank to use SQLite for local dev
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — add your Vercel frontend URL for production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT lifetimes (minutes / days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email — leave blank to disable (uses dummy backend)
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=SmartParking <noreply@smartparking.com>

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Supabase (optional — only if using Supabase storage/auth)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...
